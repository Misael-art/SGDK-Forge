      "cooldown_frames": 120
    },
    {
      "id": "lumen_refill_column",
      "telegraph_frames": 16,
      "active_frames": 96,
      "lane_sequence": [1],
      "hazard_body": "lumen_orb",
      "player_response": "collect to charge Pulse",
      "cooldown_frames": 180
    },
    {
      "id": "hoof_slam_center",
      "telegraph_frames": 72,
      "active_frames": 24,
      "lane_sequence": [1],
      "hazard_body": "boss_wave",
      "player_response": "leave center, return for weakpoint window",
      "cooldown_frames": 110
    },
    {
      "id": "double_shockwave",
      "telegraph_frames": 56,
      "active_frames": 36,
      "lane_sequence": [0, 2],
      "hazard_body": "boss_wave",
      "player_response": "center lane, then jump or Pulse",
      "cooldown_frames": 120
    },
    {
      "id": "falling_debris_gap",
      "telegraph_frames": 48,
      "active_frames": 40,
      "lane_sequence": [0, 1],
      "hazard_body": "meteor_diagonal",
      "player_response": "read safe right lane",
      "cooldown_frames": 100
    },
    {
      "id": "core_beam_sweep",
      "telegraph_frames": 72,
      "active_frames": 48,
      "lane_sequence": [0, 1, 2, 1],
      "hazard_body": "astral_mark",
      "player_response": "follow sweep gap and hold Pulse",
      "cooldown_frames": 130
    },
    {
      "id": "triple_lane_crush",
      "telegraph_frames": 96,
      "active_frames": 24,
      "lane_sequence": [0, 2, 1],
      "hazard_body": "boss_wave",
      "player_response": "react to telegraph order, no random lanes",
      "cooldown_frames": 160
    },
    {
      "id": "lumen_burst_then_core",
      "telegraph_frames": 32,
      "active_frames": 72,
      "lane_sequence": [0, 1, 2],
      "hazard_body": "lumen_orb_then_boss_weakpoint",
      "player_response": "collect, align center, Pulse chest core",
      "cooldown_frames": 180
