    "damage_to_player": "only through authored attack entities",
    "damage_to_boss": "charged Pulse must overlap active weakpoint window",
    "safe_lane_rule": "every attack pattern must leave at least one readable safe lane unless scripted control lock is active",
    "pressure_rule": "pressure remains active during boss but cannot instantly kill during weakpoint hitstop"
  },
  "weak_points": [
    {
      "id": "left_horn",
      "phase": 1,
      "hits_required": 2,
      "active_window_frames": 48,
      "lane_alignment": "left_or_center",
      "break_effect": "reduces lateral_wave frequency by 35 percent"
    },
    {
      "id": "right_horn",
      "phase": 1,
      "hits_required": 2,
      "active_window_frames": 48,
      "lane_alignment": "right_or_center",
      "break_effect": "removes one lane_lock_shadow variant"
    },
    {
      "id": "front_hoof",
      "phase": 2,
      "hits_required": 3,
      "active_window_frames": 40,
      "lane_alignment": "lane_under_hoof_after_slam",
      "break_effect": "shockwave active_steps reduced by 1"
    },
    {
      "id": "chest_core",
      "phase": 3,
      "hits_required": 4,
      "active_window_frames": 36,
      "lane_alignment": "center lane during core expose",
      "break_effect": "boss defeated"
    }
  ],
  "phases": [
    {
      "phase": 1,
      "name": "horn_pressure",
      "goal": "break both horns",
      "pressure_per_second": 2,
      "speed_q8_8": 512,
      "patterns": ["lateral_wave_left_right", "lane_lock_shadow", "lumen_refill_column"]
    },
    {
      "phase": 2,
      "name": "hoof_impact",
      "goal": "break front hoof",
      "pressure_per_second": 3,
      "speed_q8_8": 576,
      "patterns": ["hoof_slam_center", "double_shockwave", "falling_debris_gap"]
    },
    {
      "phase": 3,
      "name": "core_confrontation",
      "goal": "hit chest core four times",
      "pressure_per_second": 4,
      "speed_q8_8": 640,
      "patterns": ["core_beam_sweep", "triple_lane_crush", "lumen_burst_then_core"]
    }
  ],
  "attack_patterns": [
    {
      "id": "lateral_wave_left_right",
      "telegraph_frames": 48,
      "active_frames": 32,
      "lane_sequence": [0, 1, 2],
      "hazard_body": "boss_wave",
      "player_response": "move opposite or jump low variant",
      "cooldown_frames": 90
    },
    {
      "id": "lane_lock_shadow",
      "telegraph_frames": 64,
      "active_frames": 48,
      "lane_sequence": [0, 2],
