  "phase_transition_rules": [
    "phase transition freezes hazard spawn for 45 frames",
    "boss visual stage changes during control-safe hold",
    "HUD weakpoint markers update before attacks resume",
    "all old attack entities are cleared before next phase"
  ],
  "failure_rules": {
    "integrity_zero": "enter game_over_result",
    "pressure_100": "enter chase_caught_result unless boss final hit is resolving",
    "timeout": "not used in first boss spec"
  },
  "validation_plan": [
    "each pattern has one safe lane in authored fixtures",
    "each weakpoint can be hit with charged Pulse in a deterministic replay",
    "worst-frame scanline pressure measured before runtime delivery",
    "boss never hides HUD, lane or active telegraph"
  ]
}
