{
  "schema_version": "1.0.0",
  "status": "planned",
  "boss_id": "master_pursuer",
  "boss_card_ref": "doc/boss_setpiece_card.json",
  "collision_ref": "doc/collision_system_contract.json",
  "design_decision": "race_boss_with_attack_entities_and_pulse_weakpoints",
