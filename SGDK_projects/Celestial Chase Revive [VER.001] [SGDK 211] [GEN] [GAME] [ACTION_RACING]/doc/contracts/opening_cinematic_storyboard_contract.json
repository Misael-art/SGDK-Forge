  "cinematic_direction": {
    "intention": "Introduce the beacon rupture, bind Lio to the Lumen core and make the pursuit visible before control starts.",
    "narrative_structure": "quiet scale, rupture, personal command, object charge, threat reveal, road awakening and clean control handoff",
    "cinematic_language_methods": [
      "panel sequence with short text",
      "scroll-pan reveals instead of video playback",
      "palette and audio stingers for the catalyst event",
      "single-frame reaction and shake for impact",
      "letterbox withdrawal into the playable road"
    ],
    "selected_fake_cinema_tools": [
      "panel_sequence",
      "pan_scroll",
      "hold_frame",
      "lighting_as_narrative",
      "sound_as_primary_force",
      "palette_flash",
      "portrait_blink_mouth",
      "strong_static_composition"
    ],
    "signature_moment": "The Master Pursuer appears as a horn-crown silhouette in the horizon while the Lumen brightens, making the chase visible before the HUD exists."
  },
