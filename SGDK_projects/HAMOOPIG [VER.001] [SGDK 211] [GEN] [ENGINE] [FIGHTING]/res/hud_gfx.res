ALIGN
// SF HUD bars + KO from user sheet (placeholder / prototype)
SPRITE spr_hud_energy_y  "sprite/hud/energy_authorial_p1.png"  16  2 FAST 0
SPRITE spr_hud_energy_r  "sprite/hud/energy_red.png"     16  2 FAST 0
SPRITE spr_hud_energy_y_p2  "sprite/hud/energy_authorial_p2.png"  16  2 FAST 0
SPRITE spr_hud_energy_r_p2  "sprite/hud/energy_red_p2.png"     16  2 FAST 0
SPRITE spr_hud_ko        "sprite/hud/ko.png"             6  3 FAST 0
// Compact fixed-width cells. The runtime uses the first two tiles as the
// opaque empty track and the second two as the charged cyan state.
SPRITE spr_hud_energy_segment "sprite/hud/energy_yellow_segment.png" 2 1 FAST 0
SPRITE spr_hud_damage_segment "sprite/hud/energy_damage_segment.png" 2 1 FAST 0
SPRITE spr_hud_clock_digit "sprite/hud/clock_digits_transparent.png" 2 2 FAST 0
SPRITE spr_hud_portrait_ryo "sprite/hud/portrait_ryo.png" 4 4 FAST 0
SPRITE spr_hud_portrait_ken "sprite/hud/portrait_ken.png" 4 4 FAST 0
SPRITE spr_hud_portrait_musgo "sprite/hud/portrait_musgo.png" 4 4 FAST 0
SPRITE spr_select_roster "sprite/select/roster_icons.png" 3 3 FAST 0
SPRITE spr_hud_life_track "sprite/hud/life_track_empty.png" 8 2 FAST 0
SPRITE spr_hud_ko_banner "sprite/hud/ko_banner_big.png" 12 6 FAST 0
// P1/P2 yellow as plane tiles. NONE/NONE keeps 32 spatial tiles each for WINDOW.
TILESET ts_hud_life_track "sprite/hud/life_track_chassis.png" NONE NONE ROW
TILESET ts_hud_special_segment "sprite/hud/special_blue_segment.png" NONE NONE ROW
TILESET ts_hud_clock "sprite/hud/clock_digits_transparent.png" NONE NONE ROW
TILESET ts_hud_message_font "sprite/hud/message_font.png" NONE NONE ROW
