WAV snd_300 "snd/snd_300.wav" XGM
WAV snd_501 "snd/snd_501.wav" XGM
WAV snd_502 "snd/snd_502.wav" XGM
WAV snd_551 "snd/snd_551.wav" XGM
WAV snd_606 "snd/snd_606.wav" XGM
WAV snd_confirm "snd/snd_confirm.wav" XGM
WAV snd_haohmaru_618 "snd/snd_haohmaru_618.wav" XGM
