#include <genesis.h>

#include "core/app.h"
#include "game_vars.h"
#include "resources.h"
#include "system/audio.h"
#include "system/input.h"

#define BRAND_PHASE_ENGINE 0
#define BRAND_PHASE_AUTHOR 1
#define BRAND_PHASE_PROJECT 2

#define BRAND_ENGINE_END 150
#define BRAND_AUTHOR_END 315
#define BRAND_PROJECT_END 520

#define BRAND_TILE_FX TILE_USER_INDEX
#define BRAND_TILE_LOGO (TILE_USER_INDEX + 128)
#define BRAND_TILE_PRESENTS (TILE_USER_INDEX + 512)

#define BRAND_MAX_SPARKS 12
#define BRAND_MAX_MONOGRAM 2
#define BRAND_MAX_SHIELD 1
#define BRAND_GLOW_INDEX 3

static u8 sBrandPhase;
static u16 sBrandFrame;
static s16 sBrandLineScroll[224];

static const u16 BRAND_ENGINE_SHIMMER[4] = {
    0x08AE, 0x0ACE, 0x0EEE, 0x0ACE
};

static const u16 BRAND_ENGINE_HEAT[8] = {
    0x0000, 0x0000, 0x0200, 0x0600,
    0x0E00, 0x0E40, 0x0EA0, 0x0EE0
};

static const u16 BRAND_AUTHOR_SCAN[4] = {
    0x0040, 0x0080, 0x00C0, 0x0EE0
};

static const u16 BRAND_PROJECT_FLASH[5] = {
    0x0E40, 0x0E80, 0x0EA0, 0x0EE0, 0x0EEE
};

static Sprite* sBrandSparks[BRAND_MAX_SPARKS];
static Sprite* sBrandMonogram[BRAND_MAX_MONOGRAM];
static Sprite* sBrandShield;
static Sprite* sBrandGlow;
static s16 sBrandSparkVX[BRAND_MAX_SPARKS];
static s16 sBrandSparkVY[BRAND_MAX_SPARKS];
static s16 sBrandSparkFrame[BRAND_MAX_SPARKS];

static void brandStopPsg(void)
{
    AUDIO_stopAll();
}

static void brandPulsePsg(u8 channel, u16 tone, u8 envelope)
{
    PSG_setFrequency(channel, tone);
    PSG_setEnvelope(channel, envelope);
}

static void brandResetScroll(void)
{
    u16 i;

    VDP_setScrollingMode(HSCROLL_PLANE, VSCROLL_PLANE);
    VDP_setHorizontalScroll(BG_A, 0);
    VDP_setHorizontalScroll(BG_B, 0);
    VDP_setVerticalScroll(BG_A, 0);
    VDP_setVerticalScroll(BG_B, 0);

    for (i = 0; i < 224; i++) {
        sBrandLineScroll[i] = 0;
    }
}

static void brandResetScreen(void)
{
    SPR_reset();
    SPR_update();
    AUDIO_stopAll();
    brandResetScroll();
    VDP_clearPlane(BG_A, TRUE);
    VDP_clearPlane(BG_B, TRUE);
    PAL_setPalette(PAL0, palette_black, CPU);
    PAL_setPalette(PAL1, palette_black, CPU);
    PAL_setPalette(PAL2, palette_black, CPU);
    PAL_setPalette(PAL3, palette_black, CPU);
    VDP_setTextPalette(PAL1);
    VDP_setBackgroundColor(0);
}

static void brandDrawFxTiles(void)
{
    u16 x;
    u16 y;
    bool loadPalette = TRUE;
    const u16 attr = TILE_ATTR_FULL(PAL0, FALSE, FALSE, FALSE, BRAND_TILE_FX);

    for (y = 0; y < 28; y += 4) {
        for (x = 0; x < 48; x += 16) {
            VDP_drawImageEx(BG_B, &img_brand_fx_tiles, attr, x, y, loadPalette, FALSE);
            loadPalette = FALSE;
        }
    }
}

static void brandAnimateFx(u16 frame, s16 speed)
{
    VDP_setHorizontalScroll(BG_B, (s16)((frame >> 1) & 31) * speed);
    VDP_setVerticalScroll(BG_B, (s16)((frame >> 3) & 3));
}

static void brandSparksEnter(s16 originX, s16 originY, s16 count)
{
    u16 i;

    for (i = 0; i < BRAND_MAX_SPARKS; i++) {
        sBrandSparks[i] = NULL;
        sBrandSparkVX[i] = 0;
        sBrandSparkVY[i] = 0;
        sBrandSparkFrame[i] = -1;
    }

    for (i = 0; i < count && i < BRAND_MAX_SPARKS; i++) {
        sBrandSparks[i] = SPR_addSprite(&spr_brand_spark,
                                        originX - 4, originY - 4,
                                        TILE_ATTR(PAL2, FALSE, FALSE, FALSE));
        if (sBrandSparks[i] != NULL) {
            sBrandSparkVX[i] = (s16)((i * 13 + 7) & 15) - 7;
            sBrandSparkVY[i] = (s16)(((i * 11 + 5) & 15) | 1) * -1;
            sBrandSparkFrame[i] = 0;
        }
    }
}

static void brandSparksUpdate(void)
{
    u16 i;

    for (i = 0; i < BRAND_MAX_SPARKS; i++) {
        if (sBrandSparks[i] == NULL) continue;
        sBrandSparks[i]->x += sBrandSparkVX[i];
        sBrandSparks[i]->y += sBrandSparkVY[i];
        sBrandSparkVY[i] += 1;
        if (sBrandSparks[i]->y > 220 || sBrandSparks[i]->x < 0 ||
            sBrandSparks[i]->x > 320) {
            SPR_releaseSprite(sBrandSparks[i]);
            sBrandSparks[i] = NULL;
        }
    }
}

static void brandSparksExit(void)
{
    u16 i;

    for (i = 0; i < BRAND_MAX_SPARKS; i++) {
        if (sBrandSparks[i] != NULL) {
            SPR_releaseSprite(sBrandSparks[i]);
            sBrandSparks[i] = NULL;
        }
    }
}

static void brandGlowEnter(s16 x, s16 y, u8 pal)
{
    sBrandGlow = SPR_addSprite(&spr_brand_glow,
                               x - 16, y - 16,
                               TILE_ATTR(pal, TRUE, FALSE, FALSE));
}

static void brandGlowUpdate(u16 frame)
{
    if (sBrandGlow == NULL) return;
    /* 8-step breathing via 32-tile glow: shift Y by sin-like oscillation */
    sBrandGlow->y = 80 + ((s16)((frame >> 1) & 7) - 4);
}

static void brandGlowExit(void)
{
    if (sBrandGlow != NULL) {
        SPR_releaseSprite(sBrandGlow);
        sBrandGlow = NULL;
    }
}

static void brandEnterEngine(void)
{
    brandResetScreen();
    brandDrawFxTiles();
    PAL_setPalette(PAL1, img_brand_engine_logo.palette->data, CPU);
    VDP_drawImageEx(
        BG_A,
        &img_brand_engine_logo,
        TILE_ATTR_FULL(PAL1, FALSE, FALSE, FALSE, BRAND_TILE_LOGO),
        6,
        9,
        TRUE,
        FALSE
    );
    VDP_setVerticalScroll(BG_A, 42);
    /* iconic sound: anvil strike */
    AUDIO_playCue(AUDIO_CUE_BRAND_ENGINE_HIT);
    brandPulsePsg(0, 260, 2);
    brandPulsePsg(1, 520, 6);
    /* spark shower from the top of the screen, where the anvil strikes */
    brandSparksEnter(160, 12, BRAND_MAX_SPARKS);
    brandGlowEnter(160, 12, PAL2);
}

static void brandUpdateEngine(u16 frame)
{
    s16 rise = 42 - (s16)frame;

    if (rise < 0) {
        rise = 0;
    }

    VDP_setVerticalScroll(BG_A, rise);
    brandAnimateFx(frame, -1);
    brandSparksUpdate();
    brandGlowUpdate(frame);

    /* heat-wave line scroll during cooldown (F8..F30) */
    if (frame >= 8 && frame < 30) {
        u16 i;
        s16 amp = 8 - ((s16)frame - 8) / 3;
        if (amp < 0) amp = 0;
        for (i = 0; i < 224; i++) {
            u16 phase = (u16)((i + (frame << 2)) & 31);
            s16 centered = (phase < 16) ? (s16)phase : (s16)(31 - phase);
            centered -= 8;
            sBrandLineScroll[i] = (centered * amp) >> 3;
        }
        VDP_setScrollingMode(HSCROLL_LINE, VSCROLL_PLANE);
        VDP_setHorizontalScrollLine(BG_A, 0, sBrandLineScroll, 224, CPU);
    } else {
        VDP_setScrollingMode(HSCROLL_PLANE, VSCROLL_PLANE);
        VDP_setHorizontalScroll(BG_A, 0);
    }

    /* palette cooling: RED -> WHITE -> CYAN over 60 frames */
    if (frame >= 30 && frame < 90) {
        u16 idx = (frame - 30) >> 1;
        if (idx > 7) idx = 7;
        PAL_setColor(16 + 1, BRAND_ENGINE_HEAT[idx]);
    }

    if ((frame & 7) == 0) {
        PAL_setColor(16 + 14, BRAND_ENGINE_SHIMMER[(frame >> 3) & 3]);
    }

    if (frame == 18) {
        brandPulsePsg(0, 210, 1);
    } else if (frame == 46) {
        brandPulsePsg(1, 780, 4);
    } else if (frame == 110) {
        AUDIO_stopAll();
    }
}

static void brandEnterAuthor(void)
{
    brandResetScreen();
    brandDrawFxTiles();
    PAL_setPalette(PAL1, img_brand_author_logo.palette->data, CPU);
    VDP_drawImageEx(
        BG_A,
        &img_brand_author_logo,
        TILE_ATTR_FULL(PAL1, FALSE, FALSE, FALSE, BRAND_TILE_LOGO),
        6,
        10,
        TRUE,
        FALSE
    );
    VDP_setHorizontalScroll(BG_A, 0);
    /* typewriter click on entry */
    AUDIO_playCue(AUDIO_CUE_BRAND_AUTHOR_CLICK);
    brandPulsePsg(0, 640, 4);
    /* golden glow behind the monogram */
    brandGlowEnter(160, 100, PAL2);
    /* monograma MO 3D rotation: 2 sprites at offset positions for fake depth */
    sBrandMonogram[0] = SPR_addSprite(&spr_brand_monogram,
                                      144, 84,
                                      TILE_ATTR(PAL1, TRUE, FALSE, FALSE));
    if (sBrandMonogram[0] != NULL) {
        SPR_setAnim(sBrandMonogram[0], 0);
    }
}

static void brandUpdateAuthor(u16 frame)
{
    u16 cursorX;
    u16 animFrame;

    VDP_setHorizontalScroll(BG_A, 0);
    brandAnimateFx(frame, 1);
    brandGlowUpdate(frame);

    if ((frame & 3) == 0) {
        PAL_setColor(16 + 6, BRAND_AUTHOR_SCAN[(frame >> 2) & 3]);
    }

    if (frame > 42 && frame < 126) {
        cursorX = 8 + ((frame >> 2) & 23);
        VDP_drawTextBG(BG_A, " ", 7 + (((frame >> 2) - 1) & 23), 18);
        VDP_drawTextBG(BG_A, "|", cursorX, 18);
        if ((frame % 6) == 0) {
            AUDIO_playCue(AUDIO_CUE_BRAND_AUTHOR_CLICK);
        }
    }

    /* monogram rotation: 12 frames over the first 60 frames of this phase */
    if (sBrandMonogram[0] != NULL && frame < 60) {
        animFrame = (frame * 12) / 60;
        if (animFrame > 11) animFrame = 11;
        SPR_setAnim(sBrandMonogram[0], animFrame);
        if (frame < 30) {
            /* fade in by offsetting Y from 100 -> 80 */
            sBrandMonogram[0]->y = 100 - (s16)frame;
        }
    } else if (sBrandMonogram[0] != NULL && frame >= 60) {
        /* freeze at last frame, hold position */
        SPR_setAnim(sBrandMonogram[0], 11);
    }

    if (frame == 34) {
        brandPulsePsg(1, 920, 5);
    } else if (frame == 68) {
        brandPulsePsg(0, 700, 6);
    } else if (frame == 100) {
        AUDIO_stopAll();
    } else if (frame == 130) {
        /* terminal bell on exit lead */
        AUDIO_playCue(AUDIO_CUE_BRAND_AUTHOR_BELL);
    }
}

static void brandExitAuthor(void)
{
    u16 i;

    for (i = 0; i < BRAND_MAX_MONOGRAM; i++) {
        if (sBrandMonogram[i] != NULL) {
            SPR_releaseSprite(sBrandMonogram[i]);
            sBrandMonogram[i] = NULL;
        }
    }
    brandGlowExit();
}

static s16 brandWaveOffset(u16 frame, u16 line, u16 amplitude)
{
    u16 phase = (u16)((line + (frame << 2)) & 31);
    s16 centered = (phase < 16) ? (s16)phase : (s16)(31 - phase);
    centered -= 8;
    return (centered * (s16)amplitude) >> 3;
}

static void brandEnterProject(void)
{
    brandResetScreen();
    brandDrawFxTiles();
    PAL_setPalette(PAL1, img_brand_project_logo.palette->data, CPU);
    VDP_drawImageEx(
        BG_A,
        &img_brand_project_logo,
        TILE_ATTR_FULL(PAL1, FALSE, FALSE, FALSE, BRAND_TILE_LOGO),
        5,
        7,
        TRUE,
        FALSE
    );
    VDP_drawImageEx(
        BG_A,
        &img_brand_presents_text,
        TILE_ATTR_FULL(PAL1, FALSE, FALSE, FALSE, BRAND_TILE_PRESENTS),
        13,
        19,
        TRUE,
        FALSE
    );
    VDP_setScrollingMode(HSCROLL_LINE, VSCROLL_PLANE);
    /* stamp whoosh on entry */
    AUDIO_playCue(AUDIO_CUE_BRAND_PROJECT_WHOOSH);
    brandPulsePsg(0, 190, 1);
    brandPulsePsg(1, 380, 5);
    /* shield sprite at the top, falling in via animation */
    sBrandShield = SPR_addSprite(&spr_brand_shield,
                                 128, -32,
                                 TILE_ATTR(PAL1, TRUE, FALSE, FALSE));
    if (sBrandShield != NULL) {
        SPR_setAnim(sBrandShield, 0);
    }
}

static void brandUpdateProject(u16 frame)
{
    u16 i;
    u16 amplitude;
    u16 animFrame;

    if (frame < 36) {
        amplitude = 2;
    } else {
        amplitude = 0;
    }

    for (i = 0; i < 224; i++) {
        if (i < 48 || i > 178) {
            sBrandLineScroll[i] = 0;
        } else {
            sBrandLineScroll[i] = brandWaveOffset(frame, i, amplitude);
        }
    }

    VDP_setHorizontalScrollLine(BG_A, 0, sBrandLineScroll, 224, CPU);
    brandAnimateFx(frame, -1);

    /* shield falling: 4 frames of pre-calc scale at 50,75,90,100% */
    if (sBrandShield != NULL) {
        if (frame < 8) {
            animFrame = 0;
            sBrandShield->y = (s16)((s32)frame * 6) - 32;
        } else if (frame < 16) {
            animFrame = 1;
            sBrandShield->y = 16 + (s16)((s32)(frame - 8) * 4);
        } else if (frame < 24) {
            animFrame = 2;
            sBrandShield->y = 48 + (s16)((s32)(frame - 16) * 2);
        } else if (frame < 30) {
            animFrame = 3;
            sBrandShield->y = 64 + (s16)((s32)(frame - 24));
        } else {
            animFrame = 3;
            sBrandShield->y = 70;
        }
        SPR_setAnim(sBrandShield, animFrame);
    }

    if (frame < 48) {
        PAL_setColor(16 + 10, BRAND_PROJECT_FLASH[(frame / 8) % 5]);
        PAL_setColor(16 + 11, BRAND_PROJECT_FLASH[(frame / 6) % 5]);
    } else if ((frame & 15) == 0) {
        PAL_setColor(16 + 9, BRAND_PROJECT_FLASH[(frame >> 4) & 3]);
    }

    if (frame == 28) {
        /* impact thud (reverb tail) */
        AUDIO_playCue(AUDIO_CUE_BRAND_PROJECT_TAIL);
        brandPulsePsg(2, 1160, 4);
    } else if (frame == 62) {
        brandPulsePsg(0, 150, 1);
    } else if (frame == 130) {
        AUDIO_stopAll();
    }
}

static void brandExitProject(void)
{
    if (sBrandShield != NULL) {
        SPR_releaseSprite(sBrandShield);
        sBrandShield = NULL;
    }
}

static void brandSetPhase(u8 phase)
{
    if (sBrandPhase == phase) {
        return;
    }

    /* exit previous phase FX */
    if (sBrandPhase == BRAND_PHASE_AUTHOR) {
        brandExitAuthor();
    } else if (sBrandPhase == BRAND_PHASE_PROJECT) {
        brandExitProject();
    } else if (sBrandPhase == BRAND_PHASE_ENGINE) {
        brandSparksExit();
        brandGlowExit();
    }

    sBrandPhase = phase;

    if (phase == BRAND_PHASE_ENGINE) {
        brandEnterEngine();
    } else if (phase == BRAND_PHASE_AUTHOR) {
        brandEnterAuthor();
    } else {
        brandEnterProject();
    }
}

static void brandExitToBoot(void)
{
    brandSparksExit();
    brandGlowExit();
    brandExitAuthor();
    brandExitProject();
    AUDIO_stopAll();
    brandResetScroll();
    APP_changeScene(APP_SCENE_BOOT);
}

void SCENE_brandingEnter(void)
{
    gApp.showDebugHud = FALSE;
    sBrandPhase = 0xFF;
    sBrandShield = NULL;
    sBrandGlow = NULL;
    sBrandMonogram[0] = NULL;
    sBrandMonogram[1] = NULL;
    {
        u16 i;
        for (i = 0; i < BRAND_MAX_SPARKS; i++) {
            sBrandSparks[i] = NULL;
        }
    }
    AUDIO_stopAll();
    brandResetScreen();
}

void SCENE_brandingUpdate(void)
{
    const u16 frame = gApp.sceneFrames;

    if (INPUT_pressed(BUTTON_START) || INPUT_pressed(BUTTON_A)) {
        brandExitToBoot();
        return;
    }

    if (frame < BRAND_ENGINE_END) {
        brandSetPhase(BRAND_PHASE_ENGINE);
        brandUpdateEngine(frame);
        return;
    }

    if (frame < BRAND_AUTHOR_END) {
        brandSetPhase(BRAND_PHASE_AUTHOR);
        brandUpdateAuthor(frame - BRAND_ENGINE_END);
        return;
    }

    if (frame < BRAND_PROJECT_END) {
        brandSetPhase(BRAND_PHASE_PROJECT);
        brandUpdateProject(frame - BRAND_AUTHOR_END);
        return;
    }

    brandExitToBoot();
}
