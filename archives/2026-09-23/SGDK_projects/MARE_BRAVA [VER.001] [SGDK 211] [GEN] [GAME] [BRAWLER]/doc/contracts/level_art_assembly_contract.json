    "dominant_route": "level_art_modular_assembly",
    "asset_strategy": "scene_kit_then_agent_assembled_world",
    "resource_loading_model": "BG_A tilemap_streaming + BG_B full_resident_loop + foreground priority/sprite_graft candidates + scene_local sprites/HUD",
    "forbidden_shortcuts_until_evidence": [
      "whole_panorama_as_tilemap",
      "arena_panel_as_final_layout",
      "image_model_decides_level_composition",
      "res_promotion_before_object_role_map",
      "ready_for_aaa_before_blastem_budget"
