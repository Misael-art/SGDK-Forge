  "assembly_grammar": {
    "density_rules": [
      {
        "area": "walkable_lane",
        "rule": "minimum_detail_needed_for_ground_readability; avoid high-frequency plank noise behind characters"
      },
      {
        "area": "arena_pressure_zones",
        "rule": "landmark visible but center combat space remains clean"
      },
      {
        "area": "breathing_zones",
        "rule": "lower prop density; pickup silhouette gets priority"
      },
      {
        "area": "ring_out_zone",
        "rule": "dark water + pale foam contrast is the strongest gameplay signal"
      }
    ],
    "placement_rules": [
      "large_landmarks anchor arena identity, not every screen",
      "repeating props vary by rotation/stacking but preserve tile reuse",
      "foreground pilings appear near screen edges or non-critical action zones",
      "nets/ropes can frame but never obscure active telegraphs",
      "BG_B motion must be slower than BG_A and less contrasty than gameplay"
    ],
    "seam_rules": [
      "streaming columns must not introduce unique landmark seams inside viewport",
      "repeating boardwalk patterns need hidden variation every 2-3 screens",
      "BG_B loop seam must be proven separately from BG_A streaming seam"
    ]
  },
  "expected_artifacts_before_res": [
    "dock_scene_kit_inventory.json",
    "object_role_map.json",
    "world_layout_board_1344x224.png",
    "object_placement_map.json",
