  "created_at": "2026-07-03",
  "purpose": "Corrigir a rota visual do CAIS_01 para que o level seja construido pelo agente canonico a partir de kit modular, level design, camera e streaming, em vez de delegar a composicao final a uma imagem panoramica pronta.",
  "curatorial_decision": {
    "previous_world_panels_status": "mood_reference_only",
    "previous_contact_sheet_status": "directional_evidence_only",
    "not_allowed_as": [
      "production_tilemap_source",
      "res_promotion_source",
      "streaming_world_source",
      "final_level_layout"
    ],
    "allowed_as": [
      "palette_mood_reference",
      "landmark_reference",
      "material_language_reference",
      "negative_evidence_for_panorama_first_pipeline"
    ],
    "reason": "Os painéis prontos congelam a fase como ilustração e transferem decisões de level design, densidade, ritmo, câmera e autoria visual para o modelo de imagem."
  },
  "ownership_model": {
    "image_model_role": "generate_modular_source_candidates_only",
    "canonical_agent_role": "assemble_level_layout_and_visual_grammar",
    "human_role": "ratify_direction_and_select_sources",
    "runtime_role": "prove_streaming_budget_and_gameplay_in_emulator"
  },
