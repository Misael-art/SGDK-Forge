        "x_range": "0..160",
        "visual_need": "estabelecer cais, mar e direcao sem excesso de obstrucao"
      },
      {
        "phase": "pressure",
        "x_range": "160..480",
        "visual_need": "arena limpa para ensinar combo com landmarks discretos"
      },
      {
        "phase": "breathing",
        "x_range": "480..560",
        "visual_need": "respiro com pickup, menor densidade de obstaculos"
      },
      {
        "phase": "pressure_high",
        "x_range": "560..880",
        "visual_need": "barco/mercado como landmark e gestao de espaco contra grappler"
      },
      {
        "phase": "breathing",
        "x_range": "880..960",
        "visual_need": "preparar visualmente a beirada e reduzir ruido antes do payoff"
      },
      {
        "phase": "payoff",
        "x_range": "960..1280",
        "visual_need": "beirada/ring-out como maior contraste funcional da cena"
      }
    ],
    "gameplay_visual_contract": [
      "faixa de luta sempre legivel em 320x224",
      "beirada de agua sempre comunica risco antes do empurrao",
      "landmarks guiam golden path sem setas nem texto obrigatorio",
      "foreground nunca cobre hitbox, HUD, spawn ou telegraph"
    ]
  },
