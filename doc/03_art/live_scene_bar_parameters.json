    "train_agent": "teach_parameters_as_binary_not_handle_names",
    "laboratory": "extreme_multiplex_3d_raycast_plane_scroll_only_here_lab_not_delivery",
    "curation": "promote_number_or_axiom_only_with_rom_proof"
