  "not_canon": [
    "4_to_8_simultaneous_palettes",
    "xgm2_always_lighter_under_heavy_dma",
    "1000_sprites_as_product_default",
    "97_percent_cpu_as_target",
    "widescreen_or_mode7_as_delivery_gate",
    "60fps_claim_without_measured_scene_plus_audio"
  ]
