    "dump_forbidden": true,
    "second_pass_after_fit": true
  },
  "sprites": {
    "sat_max": 80,
    "per_scanline_h40": 20,
    "pixels_per_scanline_h40": 320,
    "per_scanline_h32": 16,
    "pixels_per_scanline_h32": 256,
    "multiplex_beyond_sat": "opt_in_lab_or_signature_with_measured_cpu_dma",
    "extreme_multiplex_observed": "shannon_demos_not_product_default"
  },
  "timing": {
    "product_2d_arcade_fps": 60,
    "software_3d_fps": "declare_measured_with_music",
    "platform_critical_lag_frames": 0,
    "benchmark_with_audio_loaded": true,
    "cpu_dma_percent": "declare_measured_not_a_target_to_hit"
  },
  "dma_audio": {
    "graphics_and_audio_one_budget": true,
    "xgm_family_default": true,
    "xgm_vs_xgm2": "measure_on_heaviest_scene",
    "xgm2_not_automatically_lighter_under_heavy_dma": true,
    "sample_dump_forbidden_as_final_bgm": true
  },
  "sgdk": {
    "role": "base_not_ceiling",
    "api_truth": "sdk/sgdk-2.11/inc/",
    "custom_dma_multiplex_asm_when_quality_requires": true
  },
  "workflow": {
    "order": [
      "limits",
      "storyboard_pixels",
      "choreography",
      "measure",
      "budget",
      "asset_contract",
      "source_then_native_translate",
      "second_pass_detail",
      "rom",
      "evidence"
