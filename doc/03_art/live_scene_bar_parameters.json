{
  "schema_version": "1.0.0",
  "bar_id": "live_scene_bar_rheo_pigsy_craft",
  "doc": "doc/03_art/18_live_scene_bar.md",
  "note": "Numeros de concepcao. Observed practice, not invented hardware. Headers SGDK 2.11 beat this file on API names.",
  "display": {
