+def _geometry_cells(sprite: dict[str, Any]) -> list[dict[str, int]]:
+    """Decompose one logical rectangle into legal VDP hardware cells."""
+    explicit = sprite.get("hardware_cells")
+    if isinstance(explicit, list):
