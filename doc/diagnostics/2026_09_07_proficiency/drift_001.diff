+    w, h = max(1, _int(sprite.get("w"), 1)), max(1, _int(sprite.get("h"), 1))
+    cells = []
+    for oy in range(0, h, 32):
+        for ox in range(0, w, 32):
+            cells.append({"x": x + ox, "y": y + oy,
+                          "w": min(32, w - ox), "h": min(32, h - oy)})
+    return cells
 
 
