{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/aaa_agent_proficiency_eval_suite.schema.json",
  "title": "AAA Agent Proficiency Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "purpose",
    "scoring_rule",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "aaa_agent_proficiency_eval_suite"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated_curation",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "scoring_rule": {
      "type": "string"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
