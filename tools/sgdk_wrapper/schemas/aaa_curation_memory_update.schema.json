{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/aaa_curation_memory_update.schema.json",
  "title": "AAA Curation Memory Update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "purpose",
    "memory_scope",
    "key_decisions",
    "canonical_load_order",
    "must_not_forget",
    "pending_actions_after_runner_recovery"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "aaa_curation_memory_update"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated_curation",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "memory_scope": {
      "type": "object",
      "additionalProperties": true
    },
    "key_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "canonical_load_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "must_not_forget": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_actions_after_runner_recovery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
