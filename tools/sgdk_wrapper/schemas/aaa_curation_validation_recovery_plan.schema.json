{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/aaa_curation_validation_recovery_plan.schema.json",
  "title": "AAA Curation Validation Recovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "purpose",
    "current_blocker",
    "promotion_policy",
    "recovery_steps",
    "status_files_to_update_after_validation",
    "explicit_non_goals"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "aaa_curation_validation_recovery_plan"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated_curation",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "current_blocker": {
      "type": "object",
      "additionalProperties": true
    },
    "promotion_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "recovery_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "status_files_to_update_after_validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explicit_non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
