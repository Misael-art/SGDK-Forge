{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/aaa_pipeline_curated_skill_map.schema.json",
  "title": "AAA Pipeline Curated Skill Map",
  "description": "Contrato machine-readable para roteamento apenas a owners ativos, com excecoes experimentais explicitamente bloqueadas por benchmark.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "default_gate",
    "lifecycle_registry",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "artifact_kind": {
      "const": "aaa_pipeline_curated_skill_map"
    },
    "status": {
      "enum": [
        "active",
        "implemented_pending_runner_verification"
      ]
    },
    "default_gate": {
      "const": "aaa-pipeline-guardian"
    },
    "lifecycle_registry": {
      "type": "string",
      "pattern": "^references/skill_lifecycle_registry\\.json$"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "skills"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^skills/[a-z0-9_-]+/[a-z0-9_-]+$"
          }
        },
        "decision": {
          "enum": [
            "canonical",
            "experimental_requires_benchmark"
          ]
        }
      }
    }
  }
}
