{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/aaa_status_vocabulary_map.schema.json",
  "title": "AAA Status Vocabulary Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "purpose",
    "global_rules",
    "status_map",
    "forbidden_synonym_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "aaa_status_vocabulary_map"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated_curation",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "global_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "forbidden_synonym_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
