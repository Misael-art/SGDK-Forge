{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/aaa_video_curation_decision_matrix.schema.json",
  "title": "AAA Video Curation Decision Matrix",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "summary_counts",
    "create_new_skill",
    "improve_existing",
    "already_covered",
    "discard_or_defer",
    "case_studies",
    "pipeline_updates"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "aaa_video_curation_decision_matrix"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated_curation",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "summary_counts": {
      "type": "object"
    },
    "create_new_skill": {
      "type": "array",
      "minItems": 1
    },
    "improve_existing": {
      "type": "array",
      "minItems": 1
    },
    "already_covered": {
      "type": "array"
    },
    "discard_or_defer": {
      "type": "array"
    },
    "case_studies": {
      "type": "array"
    },
    "pipeline_updates": {
      "type": "array"
    }
  }
}
