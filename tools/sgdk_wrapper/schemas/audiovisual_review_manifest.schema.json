{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/audiovisual_review_manifest.schema.json",
  "title": "SGDK Audiovisual Qualified Review Manifest",
  "description": "Hash-bound human or capable-reviewer packet. It records what was actually inspected; it is not generated by media metadata alone.",
  "type": "object",
  "required": [
    "reviewer",
    "method",
    "evidence_root",
    "tools",
    "method_capabilities",
    "source_media",
    "observed_intervals",
    "coverage",
    "verdicts"
  ],
  "properties": {
    "reviewer": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "evidence_root": {"type": "string", "minLength": 1},
    "tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claim_scope": {"type": "string", "minLength": 1},
    "method_capabilities": {
      "type": "object",
      "required": ["video_playback", "audio_audition"],
      "properties": {
        "images_only": {"type": "boolean"},
        "video_playback": {"type": "boolean"},
        "audio_audition": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "source_media": {
      "type": "object",
      "required": ["video_sha256", "rom_sha256"],
      "properties": {
        "video_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "audio_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "rom_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "observed_intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_seconds", "end_seconds", "actually_seen", "evidence_refs"],
        "properties": {
          "event_id": {"type": "string"},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "actually_seen": {"const": true},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "required": ["unexamined_intervals"],
      "properties": {
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "unexamined_intervals": {
          "type": "array",
          "items": {
            "anyOf": [
              {"type": "string", "pattern": "^\\s*[0-9]+(?:\\.[0-9]+)?\\s*[-–]\\s*[0-9]+(?:\\.[0-9]+)?\\s*$"},
              {"$ref": "#/$defs/interval"}
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "verdicts": {
      "type": "object",
      "required": ["visual_quality", "motion_quality", "audio_quality"],
      "properties": {
        "visual_quality": {"$ref": "#/$defs/verdict"},
        "motion_quality": {"$ref": "#/$defs/verdict"},
        "audio_quality": {"$ref": "#/$defs/verdict"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["start_seconds", "end_seconds"],
      "properties": {
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"type": "string", "enum": ["passed", "failed", "needs_review"]},
        "rationale": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
