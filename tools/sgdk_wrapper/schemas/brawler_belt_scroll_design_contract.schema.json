{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/brawler_belt_scroll_design_contract.schema.json",
  "title": "Brawler Belt-Scroll Design Contract",
  "description": "Design-level contract for brawler_belt_scroll projects. Holds player roster, enemy archetypes, pickup catalog, stage progression, modes, combat and balance sections as embedded blocks. The TDD continues to own runtime/technical decisions; this contract only describes the gameplay surface. Time unit is 'frames' (1/60 s) for combat, iframe, spawn, and pickup. Per-enemy stats are read alongside the per-archetype frame data contract.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "specialization_id",
    "registry_source",
    "time_unit",
    "camera",
    "player_count",
    "enemy_count_on_screen_max",
    "pickup_drop",
    "stage_progression",
    "iframe_on_hit",
    "player_roster",
    "enemy_archetypes",
    "pickup_catalog",
    "stages",
    "modes",
    "combat",
    "balance",
    "doc_refs"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "specialization_id": {
      "type": "string",
      "const": "brawler_belt_scroll"
    },
    "registry_source": {
      "type": "string",
      "const": "doc/07_game_design/genre_specialization_registry.json"
    },
    "time_unit": { "type": "string", "const": "frames" },
    "camera": {
      "type": "string",
      "const": "horizontal_lanes"
    },
    "player_count": {
      "type": "string",
      "enum": ["1", "1_to_2", "2"]
    },
    "enemy_count_on_screen_max": {
      "type": "integer",
      "const": 8,
      "description": "Frozen axis. Cap 8 inimigos simultaneos na tela."
    },
    "pickup_drop": {
      "type": "string",
      "enum": ["health_and_score", "health_and_score_and_weapon", "health_and_score_and_extra_life"]
    },
    "stage_progression": {
      "type": "string",
      "const": "linear_with_bosses"
    },
    "iframe_on_hit": {
      "type": "string",
      "const": "on"
    },
    "player_roster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "role",
          "archetype",
          "starting_hp",
          "iframe_frames",
          "special_move_id",
          "lore_id"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["player_1", "player_2", "unlockable", "secret", "boss_player"]
          },
          "archetype": {
            "type": "string",
            "enum": ["brawler", "speedster", "heavy", "balanced", "ranged", "tactical"]
          },
          "starting_hp": { "type": "integer", "minimum": 50, "maximum": 500 },
          "iframe_frames": { "type": "integer", "minimum": 8, "maximum": 60 },
          "special_move_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "lore_id": { "type": "string", "minLength": 1 },
          "head_metric": {
            "type": "string",
            "enum": ["S", "M", "L", "XL"],
            "description": "Advisory only."
          }
        },
        "additionalProperties": false
      }
    },
    "enemy_archetypes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "archetype",
          "enemy_archetype_frame_data_path"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "archetype": {
            "type": "string",
            "enum": ["grunt", "heavy", "thrower", "runner", "jumper", "boss", "mini_boss"]
          },
          "enemy_archetype_frame_data_path": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path to a brawler_enemy_archetype_frame_data.json instance."
          },
          "spawn_pattern": {
            "type": "string",
            "enum": ["off_screen_left", "off_screen_right", "jumps_in", "drops_in", "spawner", "door"]
          }
        },
        "additionalProperties": false
      }
    },
    "pickup_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "category", "drop_chance_pct", "max_on_screen"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["health", "score", "weapon", "extra_life", "special_bar_refill"]
          },
          "drop_chance_pct": { "type": "integer", "minimum": 1, "maximum": 100 },
          "max_on_screen": { "type": "integer", "minimum": 1, "maximum": 16 },
          "value": { "type": "integer", "minimum": 1, "maximum": 9999 },
          "weapon_durability_hits": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "lane_count",
          "wave_count",
          "boss_archetype_id",
          "hazard_policy"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "lane_count": { "type": "integer", "minimum": 1, "maximum": 3 },
          "wave_count": { "type": "integer", "minimum": 2, "maximum": 8 },
          "boss_archetype_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Foreign key into enemy_archetypes[].id where archetype=boss."
          },
          "boss_phases": { "type": "integer", "minimum": 1, "maximum": 3 },
          "hazard_policy": {
            "type": "string",
            "enum": ["no_hazards", "soft_hazards", "lethal_hazards"]
          },
          "bg_music_loop_seconds": { "type": "integer", "minimum": 8, "maximum": 60 }
        },
        "additionalProperties": false
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": {
            "type": "string",
            "enum": ["arcade", "story", "survival", "boss_rush", "versus_coop", "time_attack"]
          },
          "starting_lives": { "type": "integer", "minimum": 1, "maximum": 9 },
          "continue_policy": {
            "type": "string",
            "enum": ["unlimited", "limited_3", "score_gated", "none"]
          }
        },
        "additionalProperties": false
      }
    },
    "combat": {
      "type": "object",
      "required": ["move_set", "iframe_window_frames", "grab_throw_enabled", "super_bar_max"],
      "properties": {
        "move_set": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": ["punch", "kick", "grab", "throw", "jump", "dash", "special", "ultimate"]
          }
        },
        "iframe_window_frames": { "type": "integer", "minimum": 8, "maximum": 60 },
        "grab_throw_enabled": { "type": "boolean", "const": true },
        "super_bar_max": { "type": "integer", "minimum": 50, "maximum": 200 },
        "knockback_px": { "type": "integer", "minimum": 8, "maximum": 64 },
        "hit_stun_frames": { "type": "integer", "minimum": 4, "maximum": 30 }
      },
      "additionalProperties": false
    },
    "balance": {
      "type": "object",
      "required": ["evidence_paths", "method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["dps_first", "wave_playtest", "boss_playtest", "playtest_then_curve", "hybrid"]
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "description": "Project-relative paths to balance evidence (wave clear logs, dps tables, iframe playtest). Required to lift past vertical_slice.",
          "items": { "type": "string", "minLength": 1 }
        },
        "dps_target_per_player": {
          "type": "object",
          "description": "Advisory. Target DPS per player archetype.",
          "additionalProperties": { "type": "integer" }
        }
      },
      "additionalProperties": false
    },
    "doc_refs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
