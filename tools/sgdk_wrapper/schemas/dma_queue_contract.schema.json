{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/dma_queue_contract.schema.json",
  "title": "DMA Queue Contract",
  "description": "Contract for safe SGDK VRAM streaming, dirty tile uploads and tile animation inside VBlank budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "project",
    "vblank_budget_bytes",
    "owners",
    "vram_slots",
    "uploads",
    "active_animation_windows",
    "teardown_policy",
    "fallback_plan",
    "status",
    "blockers"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "artifact_kind": { "type": "string", "const": "dma_queue_contract" },
    "project": { "type": "string", "minLength": 1 },
    "vblank_budget_bytes": { "type": "integer", "minimum": 0 },
    "owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "vram_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_tile", "tile_count", "owner", "lifetime"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start_tile": { "type": "integer", "minimum": 0 },
          "tile_count": { "type": "integer", "minimum": 0 },
          "owner": { "type": "string", "minLength": 1 },
          "lifetime": { "type": "string", "enum": ["scene_resident", "state_resident", "per_frame_mutable", "temporary_load"] }
        }
      }
    },
    "uploads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target_slot", "bytes", "cadence", "timing"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target_slot": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "cadence": { "type": "string", "enum": ["preload", "scene_load", "every_frame", "dirty_only", "scripted"] },
          "timing": { "type": "string", "enum": ["vblank_dma", "loading_screen_dma", "cpu_copy_lab_only", "unknown"] }
        }
      }
    },
    "active_animation_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "max_resident_frames", "max_upload_bytes_per_frame"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "max_resident_frames": { "type": "integer", "minimum": 0 },
          "max_upload_bytes_per_frame": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "teardown_policy": { "type": "string", "minLength": 1 },
    "fallback_plan": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ok", "needs_review", "blocked"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
