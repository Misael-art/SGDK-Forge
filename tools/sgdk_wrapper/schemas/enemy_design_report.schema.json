{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/enemy_design_report.schema.json",
  "title": "SGDK Enemy Design Report",
  "description": "Output of enemy-design-canonical. Aggregates role coverage, head metric audit, synergy composition.",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "timestamp",
    "target_scope",
    "status",
    "enemy_results",
    "head_metric_audit",
    "synergy_composition_map",
    "issues",
    "blocking_statuses"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "report_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "target_scope": {"type": "string"},
    "status": {"type": "string", "enum": ["passed", "warn", "blocked"]},
    "enemy_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["enemy_id", "role", "head_metric", "tactical_function", "status"],
        "properties": {
          "enemy_id": {"type": "string"},
          "role": {"type": "string"},
          "head_metric": {"type": "string", "enum": ["S", "M", "L", "XL"]},
          "tactical_function": {"type": "string"},
          "telegraph_complete": {"type": "boolean"},
          "synergy_count": {"type": "integer", "minimum": 0},
          "status": {"type": "string", "enum": ["passed", "warn", "failed"]},
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "head_metric_audit": {
      "type": "object",
      "required": ["counts_per_metric", "boss_xl_compliance", "non_boss_xl_violations"],
      "properties": {
        "counts_per_metric": {
          "type": "object",
          "properties": {
            "S": {"type": "integer", "minimum": 0},
            "M": {"type": "integer", "minimum": 0},
            "L": {"type": "integer", "minimum": 0},
            "XL": {"type": "integer", "minimum": 0}
          }
        },
        "boss_xl_compliance": {"type": "boolean"},
        "non_boss_xl_violations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "boss_with_lt_3_states": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "synergy_composition_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["composition_id", "members", "synergy_type"],
        "properties": {
          "composition_id": {"type": "string"},
          "members": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "synergy_type": {"type": "string"},
          "validated": {"type": "boolean"}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"type": "string", "enum": ["warn", "blocker"]},
          "message": {"type": "string"}
        }
      }
    },
    "blocking_statuses": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
