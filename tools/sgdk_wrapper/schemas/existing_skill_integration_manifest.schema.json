{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/existing_skill_integration_manifest.schema.json",
  "title": "Existing Skill Integration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "purpose",
    "runner_status",
    "integration_policy",
    "integrations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "existing_skill_integration_manifest"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "runner_status": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "validated_by_runner",
        "commit_created",
        "push_completed"
      ],
      "properties": {
        "local_command_execution": {
          "type": "string"
        },
        "validated_by_runner": {
          "type": "boolean"
        },
        "commit_created": {
          "type": "boolean"
        },
        "push_completed": {
          "type": "boolean"
        }
      }
    },
    "integration_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_skill_id",
          "owner_skill_path",
          "implementation_status",
          "integration_section",
          "role",
          "consumed_contracts",
          "required_behavior"
        ],
        "properties": {
          "owner_skill_id": {
            "type": "string"
          },
          "owner_skill_path": {
            "type": "string"
          },
          "handoff_path": {
            "type": "string"
          },
          "implementation_status": {
            "enum": [
              "direct_skill_section_applied",
              "sidecar_handoff_applied",
              "pending_update",
              "rejected"
            ]
          },
          "integration_section": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "consumed_contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_behavior": {
            "type": "string"
          }
        }
      }
    },
    "non_integrated_backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
