{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgdk-forge.local/schemas/external_source_reliability_rubric.schema.json",
  "title": "External Source Reliability Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "curation_date",
    "purpose",
    "global_rules",
    "confidence_levels",
    "source_type_rules",
    "case_application"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_kind": {
      "const": "external_source_reliability_rubric"
    },
    "status": {
      "enum": [
        "candidate_applied_not_verified",
        "validated_curation",
        "rejected"
      ]
    },
    "curation_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "global_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "confidence_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source_type_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "case_application": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
