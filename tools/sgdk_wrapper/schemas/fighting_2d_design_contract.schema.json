{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/fighting_2d_design_contract.schema.json",
  "title": "Fighting 2D Traditional Design Contract",
  "description": "Design-level contract for fighting_2d_traditional projects. Holds roster, lore, modes, stages and balance sections as embedded blocks. The TDD continues to own runtime/technical decisions; this contract only describes the gameplay surface. Frame counts use the 'frames' time_unit and are read alongside the per-character moveset frame data contract.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "specialization_id",
    "registry_source",
    "time_unit",
    "head_metric_policy",
    "archetype_policy",
    "balance_evidence_required",
    "rollback_netcode",
    "roster",
    "lore",
    "modes",
    "stages",
    "balance",
    "doc_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "specialization_id": {
      "type": "string",
      "const": "fighting_2d_traditional"
    },
    "registry_source": {
      "type": "string",
      "const": "doc/07_game_design/genre_specialization_registry.json"
    },
    "time_unit": {
      "type": "string",
      "const": "frames"
    },
    "head_metric_policy": {
      "type": "string",
      "enum": [
        "advisory",
        "forbidden",
        "required"
      ],
      "description": "Default is advisory. Validator never blocks by head_metric alone."
    },
    "archetype_policy": {
      "type": "string",
      "enum": [
        "design_tool_not_law",
        "required"
      ]
    },
    "balance_evidence_required": {
      "type": "boolean",
      "const": true
    },
    "rollback_netcode": {
      "type": "string",
      "enum": [
        "not_applicable",
        "advisory_only",
        "blocking"
      ],
      "description": "V1 is not_applicable. Mega Drive has no native rollback netcode; do not infer."
    },
    "roster": {
      "type": "object",
      "required": [
        "size",
        "characters"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "display_name",
              "role",
              "archetype",
              "moveset_frame_data_path",
              "lore_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "secret",
                  "boss",
                  "training_dummy"
                ]
              },
              "archetype": {
                "type": "string",
                "minLength": 1
              },
              "moveset_frame_data_path": {
                "type": "string",
                "minLength": 1,
                "description": "Project-relative path to a fighting_moveset_frame_data.json instance."
              },
              "lore_id": {
                "type": "string",
                "minLength": 1,
                "description": "Foreign key into the lore.characters block."
              },
              "head_metric": {
                "type": "string",
                "enum": [
                  "S",
                  "M",
                  "L",
                  "XL"
                ],
                "description": "Advisory only. Validator never blocks by this field alone."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lore": {
      "type": "object",
      "required": [
        "characters"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "summary"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "ip_status": {
                "type": "string",
                "enum": [
                  "original",
                  "homage",
                  "public_domain",
                  "licensed"
                ]
              },
              "ip_notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "human_or_cpu_opponent",
          "round_config"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "versus",
              "arcade",
              "story",
              "training",
              "survival",
              "boss_rush",
              "online"
            ]
          },
          "human_or_cpu_opponent": {
            "type": "string",
            "enum": [
              "human_vs_human",
              "human_vs_cpu",
              "cpu_vs_cpu"
            ]
          },
          "round_config": {
            "type": "object",
            "required": [
              "round_time_limit_frames",
              "rounds_to_win",
              "max_rounds"
            ],
            "properties": {
              "round_time_limit_frames": {
                "type": "integer",
                "minimum": 1
              },
              "rounds_to_win": {
                "type": "integer",
                "minimum": 1
              },
              "max_rounds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "training_features": {
            "type": "array",
            "description": "Required when kind=training; project must ship training mode before ready_for_aaa.",
            "items": {
              "type": "string",
              "enum": [
                "input_display",
                "frame_advantage_display",
                "hitbox_viewer",
                "dummy_state_machine",
                "save_state",
                "rewind",
                "cpu_behavior_selector",
                "damage_meter_reset"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "camera_bounds_px",
          "floor_y_px",
          "hazard_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "camera_bounds_px": {
            "type": "object",
            "required": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "properties": {
              "left": {
                "type": "integer"
              },
              "right": {
                "type": "integer"
              },
              "top": {
                "type": "integer"
              },
              "bottom": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "floor_y_px": {
            "type": "integer"
          },
          "hazard_policy": {
            "type": "string",
            "enum": [
              "no_hazards",
              "soft_hazards",
              "stage_fatality"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "balance": {
      "type": "object",
      "required": [
        "evidence_paths",
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "frame_data_first",
            "matchup_matrix",
            "tournament_observed",
            "internal_playtest",
            "hybrid"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "description": "Project-relative paths to balance evidence (playtest logs, frame data tables, matchup matrix). Required to lift past vertical_slice.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tier_targets": {
          "type": "object",
          "description": "Advisory. Tier lists are design tools, not laws.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "doc_refs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
