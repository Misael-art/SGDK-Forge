{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/independent_quality_review.schema.json",
  "title": "Independent Quality Review",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "review_id", "request_digest",
    "plan_digest", "artifact_bindings", "reviewers", "synthesis",
    "quality_claim", "ready_for_aaa", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "independent_quality_review"},
    "review_id": {"type": "string"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_bindings": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/definitions/artifact"}
    },
    "reviewers": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "domain", "owner_skill", "reviewer_id", "producer_context_visible",
          "status", "findings", "external_sources"
        ],
        "properties": {
          "domain": {"type": "string"},
          "owner_skill": {"type": "string"},
          "reviewer_id": {"type": "string", "minLength": 1},
          "producer_context_visible": {"const": false},
          "status": {"enum": ["passed", "needs_adjustment", "blocked"]},
          "findings": {
            "type": "array",
            "items": {"$ref": "#/definitions/finding"}
          },
          "external_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url", "observed_at", "source_type"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https://"},
                "observed_at": {"type": "string", "format": "date"},
                "source_type": {"enum": ["primary", "storefront", "dataset", "trade_publication", "secondary"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "synthesis": {
      "type": "object",
      "required": ["growth_decision", "priority_finding_ids", "cross_domain_conflicts"],
      "properties": {
        "growth_decision": {"enum": ["proceed", "proceed_with_tracked_risks", "revise_before_growth", "human_scope_decision_required"]},
        "priority_finding_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "cross_domain_conflicts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "quality_claim": {"const": "unproven"},
    "ready_for_aaa": {"const": false},
    "claim_ceiling": {"const": "independent_quality_review_only"}
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id", "classification", "severity", "confidence",
        "blocks_growth", "evidence", "player_impact", "smallest_correction",
        "correction_owner_skill", "acceptance_evidence", "scope_change_required"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
        "classification": {"enum": ["defect", "risk", "opportunity", "taste"]},
        "severity": {"enum": ["info", "minor", "major", "critical"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "blocks_growth": {"type": "boolean"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "player_impact": {"type": "string", "minLength": 1},
        "smallest_correction": {"type": "string", "minLength": 1},
        "correction_owner_skill": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
        "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "scope_change_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
