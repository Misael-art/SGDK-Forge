{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/input_mapping_contract.schema.json",
  "title": "Input Mapping Contract",
  "description": "Maps physical Mega Drive controller inputs (D-Pad, A/B/C/Start, and X/Y/Z/Mode when 6-button) to logical game actions for the input-system-sgdk owner. Uses only real SGDK 2.11 joy.h APIs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "project",
    "controller_class",
    "action_map",
    "six_button_detection",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "artifact_kind": { "type": "string", "const": "input_mapping_contract" },
    "project": { "type": "string", "minLength": 1 },
    "controller_class": { "type": "string", "enum": ["3button", "6button", "mixed"] },
    "action_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "button"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "button": {
            "type": "string",
            "enum": ["UP", "DOWN", "LEFT", "RIGHT", "A", "B", "C", "START", "X", "Y", "Z", "MODE"]
          }
        }
      }
    },
    "six_button_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "required_before_xyz_mode"],
      "properties": {
        "api": { "type": "string", "const": "JOY_getJoypadType" },
        "required_before_xyz_mode": { "type": "boolean" }
      }
    },
    "status": { "type": "string", "enum": ["candidate_applied_not_verified", "ok", "needs_review", "blocked"] }
  }
}
