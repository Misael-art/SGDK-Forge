{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/local_ci_gate_report.schema.json",
  "title": "Local CI Gate Report",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "gate_kind",
    "status",
    "project_root",
    "generated_at",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "gate_kind": {
      "type": "string",
      "enum": [
        "local_ci"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "blocked",
        "error"
      ]
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "rom_path": {
      "type": "string"
    },
    "rom_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "workspace_scope_isolation": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "blocked"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "warn",
              "failed",
              "blocked",
              "skipped",
              "not_applicable"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "report_path": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "github_actions",
          "pre_commit_hook",
          "make_parallel",
          "debug_symbols",
          "other"
        ]
      }
    }
  },
  "additionalProperties": true
}
