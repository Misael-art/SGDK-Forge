{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/operational_loop_decision.schema.json",
  "title": "Operational Loop Decision Record",
  "description": "Decisao estrategica documentada para destravar bloqueio de loop operacional (3 builds consecutivos com os mesmos blockers).",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "project_root",
    "owner",
    "decision_date",
    "dominant_blockers",
    "strategy",
    "why_now_different",
    "progress_justification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 3
    },
    "decision_date": {
      "type": "string",
      "format": "date-time"
    },
    "dominant_blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strategy": {
      "type": "string",
      "minLength": 16
    },
    "why_now_different": {
      "type": "string",
      "minLength": 16
    },
    "progress_justification": {
      "type": "object",
      "properties": {
        "new_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "path"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "validation_report",
                  "emulator_screenshot",
                  "save_sram",
                  "visual_vdp_dump",
                  "budget_report",
                  "scene_regression_report",
                  "art_review",
                  "other"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "rom_sha256": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "meaningful_change_summary": {
          "type": "string",
          "minLength": 16
        },
        "human_decision_record": {
          "type": "object",
          "required": ["approved_by", "record_path"],
          "properties": {
            "approved_by": {
              "type": "string",
              "minLength": 3
            },
            "record_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["new_evidence"]
        },
        {
          "required": ["meaningful_change_summary"]
        },
        {
          "required": ["human_decision_record"]
        }
      ]
    }
  },
  "additionalProperties": false
}

