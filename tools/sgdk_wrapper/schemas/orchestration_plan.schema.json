{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/orchestration_plan.schema.json",
  "title": "Conservative Orchestration Plan",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "tool", "generated_at", "run_id",
    "context_digest", "coordinator_policy", "tasks", "waves", "summary",
    "token_policy", "claim_ceiling", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "orchestration_plan"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "harness_orchestration"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinator_policy": {
      "type": "object",
      "required": [
        "single_claim_owner", "single_promotion_owner", "single_final_memory_owner",
        "worker_default_access", "human_gate_may_block_only_dependent_branches"
      ],
      "properties": {
        "single_claim_owner": {"const": true},
        "single_promotion_owner": {"const": true},
        "single_final_memory_owner": {"const": true},
        "worker_default_access": {"const": "read_only"},
        "human_gate_may_block_only_dependent_branches": {"const": true}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id", "objective", "task_kind", "owner_skill", "dependencies",
          "execution_mode", "decision_reasons", "requested_model_tier", "model_tier", "expected_seconds",
          "context_capsule", "write_lease", "result_contract", "planning_warnings"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "task_kind": {"type": "string", "minLength": 1},
          "owner_skill": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "execution_mode": {"enum": ["coordinator_local", "subagent_read_only", "subagent_isolated_writer"]},
          "decision_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requested_model_tier": {"enum": ["economical", "balanced", "high_capability"]},
          "model_tier": {"enum": ["economical", "balanced", "high_capability"]},
          "expected_seconds": {"type": "integer", "minimum": 0},
          "context_capsule": {
            "type": "object",
            "required": [
              "inherit_full_history", "maximum_words", "canonical_context_digest",
              "input_artifacts", "required_output_paths", "claim_ceiling",
              "acceptance_commands", "prohibitions"
            ],
            "properties": {
              "inherit_full_history": {"const": false},
              "maximum_words": {"type": "integer", "minimum": 0, "maximum": 1200},
              "canonical_context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "input_artifacts": {"type": "array"},
              "required_output_paths": {"type": "array", "items": {"type": "string"}},
              "claim_ceiling": {"type": "string", "minLength": 1},
              "acceptance_commands": {"type": "array", "items": {"type": "string"}},
              "prohibitions": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "write_lease": {
            "type": "object",
            "required": ["mode", "paths", "protected_paths"],
            "properties": {
              "mode": {"enum": ["none", "exclusive"]},
              "paths": {"type": "array", "items": {"type": "string"}},
              "protected_paths": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "result_contract": {
            "type": "object",
            "required": ["maximum_summary_words", "raw_logs_must_be_files", "hash_bindings_required", "claim_ceiling"],
            "properties": {
              "maximum_summary_words": {"type": "integer", "minimum": 0, "maximum": 600},
              "raw_logs_must_be_files": {"const": true},
              "hash_bindings_required": {"const": true},
              "claim_ceiling": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "planning_warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["wave", "mode", "task_ids"],
        "properties": {
          "wave": {"type": "integer", "minimum": 1},
          "mode": {"enum": ["parallel_workers", "coordinator_serial"]},
          "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "task_count", "delegated_count", "coordinator_count", "writer_conflict_task_ids",
        "worker_slots", "maximum_worker_context_and_result_words"
      ],
      "properties": {
        "task_count": {"type": "integer", "minimum": 1},
        "delegated_count": {"type": "integer", "minimum": 0},
        "coordinator_count": {"type": "integer", "minimum": 0},
        "writer_conflict_task_ids": {"type": "array", "items": {"type": "string"}},
        "worker_slots": {"type": "integer", "minimum": 0, "maximum": 3},
        "maximum_worker_context_and_result_words": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "token_policy": {
      "type": "object",
      "required": [
        "goal", "static_instructions_first", "dynamic_capsule_last",
        "full_history_fork_default", "raw_logs_in_coordinator_context",
        "validation_cache_key", "final_critical_validation_must_rerun"
      ],
      "properties": {
        "goal": {"const": "minimize_total_tokens_before_minimizing_wall_clock"},
        "static_instructions_first": {"const": true},
        "dynamic_capsule_last": {"const": true},
        "full_history_fork_default": {"const": false},
        "raw_logs_in_coordinator_context": {"const": false},
        "validation_cache_key": {"const": "tool_sha256+tool_version+args+input_manifest_sha256+schema_sha256"},
        "final_critical_validation_must_rerun": {"const": true}
      },
      "additionalProperties": false
    },
    "claim_ceiling": {"const": "orchestration_plan_only"},
    "status": {"const": "ready"}
  },
  "additionalProperties": false
}
