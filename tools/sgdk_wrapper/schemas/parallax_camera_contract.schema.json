{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/parallax_camera_contract.schema.json",
  "title": "Parallax Camera Contract",
  "description": "Declares how the camera-system-sgdk owner drives parallax planes and which owner is responsible for each plane. Handoff to multi-plane-composition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "project",
    "scene_id",
    "planes",
    "plane_owner",
    "final_scroll_integer_pixel",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "artifact_kind": { "type": "string", "const": "parallax_camera_contract" },
    "project": { "type": "string", "minLength": 1 },
    "scene_id": { "type": "string", "minLength": 1 },
    "planes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plane_id", "scroll_factor"],
        "properties": {
          "plane_id": { "type": "string", "minLength": 1 },
          "scroll_factor": { "type": "number" }
        }
      }
    },
    "plane_owner": { "type": "string", "minLength": 1 },
    "final_scroll_integer_pixel": { "type": "boolean" },
    "status": { "type": "string", "enum": ["candidate_applied_not_verified", "ok", "needs_review", "blocked"] }
  }
}
