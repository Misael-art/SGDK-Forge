{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/prd_readiness_report.schema.json",
  "title": "Project PRD Readiness Report",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "status",
    "target_profile",
    "project_root",
    "generated_at",
    "summary",
    "blockers",
    "prds"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tool": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "blocked"
      ]
    },
    "target_profile": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "required",
        "missing",
        "seed",
        "filled",
        "locked",
        "not_applicable",
        "blocked"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "filled": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prd_id",
          "title",
          "path",
          "required",
          "status",
          "decision"
        ],
        "properties": {
          "prd_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "minimum_status": {
            "type": "string"
          },
          "frontmatter_present": {
            "type": "boolean"
          },
          "unlocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
