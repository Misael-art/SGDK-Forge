{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgdk-forge.local/schemas/premium_source_manifest.schema.json",
  "title": "premium_source_manifest",
  "description": "Canonical source manifest for vibe_playable_loop_v1. This single schema also documents accepted legacy shapes for migration.",
  "oneOf": [
    { "$ref": "#/definitions/canonical_v2" },
    { "$ref": "#/definitions/legacy_root_assets" },
    { "$ref": "#/definitions/legacy_single_asset" }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "source_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "model"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "model": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": ["step", "tool", "input_sha256", "output_sha256"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "input_sha256": { "$ref": "#/definitions/sha256" },
        "output_sha256": { "$ref": "#/definitions/sha256" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "variant_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "required": ["basic", "elite"],
      "properties": {
        "basic": { "$ref": "#/definitions/variant_ref" },
        "elite": { "$ref": "#/definitions/variant_ref" }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["name", "author", "usage"],
      "properties": {
        "name": { "type": "string" },
        "author": { "type": "string" },
        "usage": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "canonical_asset": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_role",
        "criticality",
        "authoring_method",
        "source_origin",
        "source_classification",
        "tool",
        "source_files",
        "transformations",
        "variants"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
        },
        "asset_role": {
          "type": "string",
          "enum": [
            "character",
            "boss",
            "enemy",
            "scene",
            "background",
            "foreground",
            "ui",
            "hud",
            "fx",
            "title_screen",
            "diagnostic",
            "unknown"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": ["critical", "supporting", "debug"]
        },
        "authoring_method": {
          "type": "string",
          "minLength": 1
        },
        "source_origin": {
          "type": "string",
          "minLength": 1
        },
        "source_classification": {
          "type": "string",
          "enum": [
            "human_authored",
            "generated_bitmap",
            "licensed_source",
            "procedural_debug",
            "unknown"
          ]
        },
        "tool": { "$ref": "#/definitions/tool" },
        "source_files": {
          "type": "array",
          "items": { "$ref": "#/definitions/source_file" }
        },
        "transformations": {
          "type": "array",
          "items": { "$ref": "#/definitions/transformation" }
        },
        "variants": { "$ref": "#/definitions/variants" },
        "license": { "$ref": "#/definitions/license" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "canonical_v2": {
      "type": "object",
      "required": ["schema_version", "report_kind", "production_source_ready", "assets"],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^2\\.[0-9]+\\.[0-9]+$"
        },
        "report_kind": {
          "type": "string",
          "enum": ["premium_source_manifest"]
        },
        "template_seed": {
          "type": "boolean"
        },
        "template_prevalidated": {
          "type": "boolean"
        },
        "production_source_ready": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/definitions/canonical_asset" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "legacy_asset": {
      "type": "object",
      "required": ["asset_id", "source_file", "source_sha256"],
      "properties": {
        "asset_id": { "type": "string" },
        "source_file": { "type": "string" },
        "source_sha256": { "$ref": "#/definitions/sha256" },
        "asset_role": { "type": "string" },
        "criticality": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" }
      },
      "additionalProperties": true
    },
    "legacy_root_assets": {
      "type": "object",
      "required": ["assets"],
      "properties": {
        "schema_version": { "type": "string" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/legacy_asset" }
        }
      },
      "additionalProperties": true
    },
    "legacy_single_asset": {
      "allOf": [
        { "$ref": "#/definitions/legacy_asset" }
      ]
    }
  }
}
