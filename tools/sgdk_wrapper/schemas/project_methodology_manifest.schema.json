{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/project_methodology_manifest.schema.json",
  "title": "SGDK Project Methodology Manifest",
  "description": "Structured adoption contract for canonical workflows, skills, validations, and explicit project claims.",
  "type": "object",
  "required": [
    "schema_version",
    "methodology_version",
    "project",
    "active_workflow",
    "required_skills",
    "required_validations",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "methodology_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "project": {
      "type": "object",
      "required": ["name", "lifecycle", "project_root_policy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "lifecycle": {
          "type": "string",
          "enum": ["new", "existing", "reseed"]
        },
        "project_root_policy": {
          "type": "string",
          "const": "all_project_material_inside_project"
        }
      },
      "additionalProperties": false
    },
    "active_workflow": {
      "type": "string",
      "const": "production-loop"
    },
    "required_skills": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"
      }
    },
    "required_validations": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "preflight_host",
          "validate_resources",
          "scene_closeout_gate",
          "freshness_audit",
          "project_hygiene",
          "project_context",
          "validate_audio",
          "audit_game_design_contracts"
        ]
      },
      "allOf": [
        {"contains": {"const": "preflight_host"}},
        {"contains": {"const": "validate_resources"}},
        {"contains": {"const": "scene_closeout_gate"}},
        {"contains": {"const": "freshness_audit"}},
        {"contains": {"const": "project_hygiene"}},
        {"contains": {"const": "project_context"}}
      ]
    },
    "claims": {
      "type": "object",
      "required": ["critical_motion", "road_physics", "modular_boss"],
      "properties": {
        "critical_motion": {
          "allOf": [
            {"$ref": "#/definitions/base_claim"},
            {
              "if": {
                "properties": {"applicability": {"const": "required"}},
                "required": ["applicability"]
              },
              "then": {
                "required": ["critical_asset_ids", "motion_gif_path", "human_approval_record_path"],
                "properties": {
                  "critical_asset_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "motion_gif_path": {"type": "string", "minLength": 1},
                  "human_approval_record_path": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        },
        "road_physics": {
          "allOf": [
            {"$ref": "#/definitions/base_claim"},
            {
              "if": {
                "properties": {"applicability": {"const": "required"}},
                "required": ["applicability"]
              },
              "then": {
                "required": ["contract_path"],
                "properties": {
                  "contract_path": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        },
        "modular_boss": {
          "allOf": [
            {"$ref": "#/definitions/base_claim"},
            {
              "if": {
                "properties": {"applicability": {"const": "required"}},
                "required": ["applicability"]
              },
              "then": {
                "required": ["contract_path"],
                "properties": {
                  "contract_path": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "base_claim": {
      "type": "object",
      "required": ["applicability", "rationale"],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": ["review_required", "not_applicable", "required"]
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": true
    }
  }
}
