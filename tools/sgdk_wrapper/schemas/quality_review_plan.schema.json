{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/quality_review_plan.schema.json",
  "title": "Quality Review Plan",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "tool", "generated_at", "review_id",
    "request_digest", "plan_digest", "review_stage", "selected_reviews",
    "deferred_domains", "required_harness_skills", "status", "blockers",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "quality_review_plan"},
    "tool": {
      "type": "object", "required": ["name", "version"],
      "properties": {
        "name": {"const": "quality_review_router"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "review_id": {"type": "string"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_stage": {"enum": ["foundation", "pre_growth", "vertical_slice", "release_candidate"]},
    "selected_reviews": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["domain", "owner_skill", "score", "selection_reasons", "model_tier", "evidence_requirements"],
        "properties": {
          "domain": {"type": "string"},
          "owner_skill": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
          "score": {"type": "integer", "minimum": 0},
          "selection_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "model_tier": {"enum": ["economical", "balanced", "high_capability"]},
          "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "deferred_domains": {
      "type": "array",
      "items": {
        "type": "object", "required": ["domain", "reason"],
        "properties": {"domain": {"type": "string"}, "reason": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "required_harness_skills": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"}
    },
    "status": {"enum": ["ready", "blocked"]},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "claim_ceiling": {"const": "quality_review_plan_only"}
  },
  "additionalProperties": false
}
