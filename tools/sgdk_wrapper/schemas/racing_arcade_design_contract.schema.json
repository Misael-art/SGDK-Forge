{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/racing_arcade_design_contract.schema.json",
  "title": "Racing Arcade Design Contract",
  "description": "Design-level contract for racing_arcade projects. Holds vehicle catalog, track catalog, race modes, item/power-up catalog, AI profile, and balance sections. The TDD continues to own runtime/technical decisions. Time unit is 'frames' (1/60 s) for lap time, top_speed, acceleration, drift. Per-vehicle stats are read alongside the per-vehicle frame data contract.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "specialization_id",
    "registry_source",
    "time_unit",
    "camera",
    "track_count_max",
    "lap_count_max",
    "ai_opponents",
    "boost_on_drift",
    "collision_model",
    "vehicle_catalog",
    "track_catalog",
    "race_modes",
    "item_catalog",
    "ai_profile",
    "hud_config",
    "balance",
    "doc_refs"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "specialization_id": { "type": "string", "const": "racing_arcade" },
    "registry_source": { "type": "string", "const": "doc/07_game_design/genre_specialization_registry.json" },
    "time_unit": { "type": "string", "const": "frames" },
    "camera": { "type": "string", "enum": ["behind", "chase", "behind_or_chase"] },
    "track_count_max": {
      "type": "integer",
      "const": 16,
      "description": "Frozen axis. Max tracks per game."
    },
    "lap_count_max": {
      "type": "integer",
      "const": 5,
      "description": "Frozen axis. Max laps per race."
    },
    "ai_opponents": {
      "type": "string",
      "enum": ["3", "5", "5_to_7", "7"],
      "description": "Frozen axis. Number of AI opponents per race."
    },
    "boost_on_drift": { "type": "string", "const": "on" },
    "collision_model": {
      "type": "string",
      "enum": ["arcade_forgiving", "sim_fair"]
    },
    "vehicle_catalog": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "weight_class",
          "vehicle_frame_data_path",
          "starting_position"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "weight_class": {
            "type": "string",
            "enum": ["light", "medium", "heavy", "formula"]
          },
          "vehicle_frame_data_path": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path to a racing_vehicle_frame_data.json instance."
          },
          "starting_position": { "type": "integer", "minimum": 1, "maximum": 16 },
          "head_metric": {
            "type": "string",
            "enum": ["S", "M", "L", "XL"],
            "description": "Advisory only."
          },
          "lore_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "track_catalog": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "display_name",
          "length_pixels",
          "lane_count",
          "shortcut_count",
          "weather_policy",
          "recommended_lap_count"
        ],
        "properties": {
          "track_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "length_pixels": { "type": "integer", "minimum": 8000, "maximum": 65535 },
          "lane_count": { "type": "integer", "minimum": 1, "maximum": 4 },
          "shortcut_count": { "type": "integer", "minimum": 0, "maximum": 4 },
          "weather_policy": {
            "type": "string",
            "enum": ["clear", "rain", "night", "random"]
          },
          "recommended_lap_count": { "type": "integer", "minimum": 1, "maximum": 5 },
          "par_lap_time_frames": { "type": "integer", "minimum": 3600, "maximum": 36000 },
          "track_music_loop_seconds": { "type": "integer", "minimum": 30, "maximum": 120 }
        },
        "additionalProperties": false
      }
    },
    "race_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": {
            "type": "string",
            "enum": ["grand_prix", "single_race", "time_trial", "battle", "endurance", "split_screen"]
          },
          "laps": { "type": "integer", "minimum": 1, "maximum": 5 },
          "ai_count": { "type": "integer", "minimum": 0, "maximum": 7 },
          "item_box_enabled": { "type": "boolean" },
          "rubber_banding_enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "item_catalog": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "category", "duration_frames", "stack_max"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["rocket", "shield", "oil_slick", "lightning", "ghost", "machine_gun", "boost", "trap"]
          },
          "duration_frames": { "type": "integer", "minimum": 1, "maximum": 600 },
          "stack_max": { "type": "integer", "minimum": 1, "maximum": 3 },
          "value": { "type": "integer", "minimum": 1, "maximum": 999 }
        },
        "additionalProperties": false
      }
    },
    "ai_profile": {
      "type": "object",
      "required": ["difficulty_levels", "drafting_enabled", "rubber_banding_enabled"],
      "properties": {
        "difficulty_levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": ["easy", "normal", "hard", "expert", "master"]
          }
        },
        "drafting_enabled": { "type": "boolean" },
        "rubber_banding_enabled": { "type": "boolean" },
        "rubber_band_strength_pct": { "type": "integer", "minimum": 0, "maximum": 50 },
        "ai_top_speed_variance_pct": { "type": "integer", "minimum": 0, "maximum": 30 }
      },
      "additionalProperties": false
    },
    "hud_config": {
      "type": "object",
      "required": ["show_position", "show_lap_counter", "show_lap_time", "show_minimap"],
      "properties": {
        "show_position": { "type": "boolean", "const": true },
        "show_lap_counter": { "type": "boolean", "const": true },
        "show_lap_time": { "type": "boolean", "const": true },
        "show_minimap": { "type": "boolean" },
        "show_speed_kmh": { "type": "boolean" },
        "show_boost_meter": { "type": "boolean" },
        "show_item_slot": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "balance": {
      "type": "object",
      "required": ["evidence_paths", "method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["top_speed_first", "track_layout_first", "ai_balanced_first", "playtest_then_curve", "hybrid"]
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "description": "Project-relative paths to balance evidence (lap time tables, ai difficulty tables, top speed tables). Required to lift past vertical_slice.",
          "items": { "type": "string", "minLength": 1 }
        },
        "difficulty_curve_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "doc_refs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
