{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/skill_lifecycle_registry.schema.json",
  "title": "SGDK Skill Lifecycle Registry",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "generated_at",
    "active_root",
    "legacy_root",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifact_kind": {
      "const": "skill_lifecycle_registry"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_root": {
      "const": "tools/sgdk_wrapper/.agent/skills"
    },
    "legacy_root": {
      "const": "tools/sgdk_wrapper/.agent/legacy/skills"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "lifecycle",
          "decision_reason",
          "replacement_skills",
          "evidence_grade",
          "source_path",
          "legacy_path",
          "content_sha256",
          "context_budget_words",
          "references_redirected",
          "restore_conditions",
          "decision_date",
          "human_approved"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "lifecycle": {
            "enum": [
              "active",
              "merged",
              "superseded",
              "deprecated",
              "experimental"
            ]
          },
          "decision_reason": {
            "type": "string",
            "minLength": 12
          },
          "replacement_skills": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "evidence_grade": {
            "type": "string",
            "minLength": 2
          },
          "source_path": {
            "type": "string",
            "pattern": "^tools/sgdk_wrapper/\\.agent/skills/"
          },
          "legacy_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "context_budget_words": {
            "type": "integer",
            "minimum": 50,
            "maximum": 10000
          },
          "references_redirected": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "restore_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "decision_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "human_approved": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "not": {
                    "const": "active"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "legacy_path": {
                  "type": "string",
                  "pattern": "^tools/sgdk_wrapper/\\.agent/legacy/skills/"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
