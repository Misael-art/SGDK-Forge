{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sprite_artifact_report.schema.json",
  "title": "Sprite Artifact Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "asset_id",
    "sheet",
    "sheet_sha256",
    "status",
    "technical_pass",
    "visual_pass",
    "cell",
    "pivot",
    "required_checks",
    "action_coverage",
    "summary",
    "findings",
    "frames",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "sprite_artifact_report.v2" },
    "asset_id": { "type": "string", "minLength": 1 },
    "sheet": { "type": "string", "minLength": 1 },
    "sheet_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": ["passed", "technical_pass_visual_fail"]
    },
    "technical_pass": { "type": "boolean" },
    "visual_pass": { "type": "boolean" },
    "cell": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 8 },
        "h": { "type": "integer", "minimum": 8 }
      }
    },
    "pivot": {
      "type": "object",
      "required": ["x", "ground_y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "ground_y": { "type": "integer", "minimum": 0 }
      }
    },
    "required_checks": {
      "type": "object",
      "required": [
        "edge_clipping",
        "detached_islands",
        "anatomy",
        "pivot",
        "foot_contact",
        "frame_delta",
        "action_coverage"
      ],
      "properties": {
        "edge_clipping": { "const": true },
        "detached_islands": { "const": true },
        "anatomy": { "const": true },
        "pivot": { "const": true },
        "foot_contact": { "const": true },
        "frame_delta": { "const": true },
        "action_coverage": { "const": true }
      },
      "additionalProperties": false
    },
    "action_coverage": {
      "type": "object",
      "required": [
        "required_actions",
        "declared_actions",
        "missing_required_actions",
        "status"
      ],
      "properties": {
        "required_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "declared_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "missing_required_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status": { "type": "string", "enum": ["passed", "failed"] }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["frames_checked", "findings", "blocking_findings"],
      "properties": {
        "frames_checked": { "type": "integer", "minimum": 1 },
        "findings": { "type": "integer", "minimum": 0 },
        "blocking_findings": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "action", "frame", "detail"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "action": { "type": "string" },
          "frame": { "type": "integer" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action",
          "frame",
          "bbox",
          "visible_pixels",
          "component_sizes",
          "grounded",
          "pivot",
          "frame_delta_ratio",
          "anatomy_review",
          "status"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "required": ["contact_sheet", "animated_captures"],
      "properties": {
        "contact_sheet": { "type": "string", "minLength": 1 },
        "animated_captures": { "type": "object", "minProperties": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } }
      },
      "then": {
        "properties": {
          "technical_pass": { "const": true },
          "visual_pass": { "const": true },
          "summary": {
            "properties": { "blocking_findings": { "const": 0 } }
          }
        }
      }
    }
  ]
}
