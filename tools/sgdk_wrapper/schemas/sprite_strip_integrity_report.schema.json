{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sprite_strip_integrity_report.schema.json",
  "title": "Sprite Strip Integrity Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "status",
    "image_path",
    "frame_width",
    "frame_height",
    "frame_count",
    "findings",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "sprite_strip_integrity_report.v1"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "needs_review", "rework"]
    },
    "image_path": {
      "type": "string",
      "minLength": 1
    },
    "frame_width": {
      "type": "integer",
      "minimum": 1
    },
    "frame_height": {
      "type": "integer",
      "minimum": 1
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "background_palette_index": {
      "type": ["integer", "null"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "additionalProperties": true,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 },
          "frame": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame", "non_background_pixels"],
        "additionalProperties": true,
        "properties": {
          "frame": { "type": "integer", "minimum": 1 },
          "non_background_pixels": { "type": "integer", "minimum": 0 },
          "bbox": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "integer" }
              }
            ]
          }
        }
      }
    }
  }
}
