{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/state_transition_contract.schema.json",
  "title": "State Transition Contract",
  "description": "Contract for SGDK game-state transitions with fade, mutex, VRAM/CRAM/SAT flush, callback reset and resource handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "project",
    "states",
    "transition_mutex",
    "sequence",
    "resource_handoff",
    "callback_reset",
    "input_lock_policy",
    "fixtures",
    "status",
    "blockers"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "artifact_kind": { "type": "string", "const": "state_transition_contract" },
    "project": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "transition_mutex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "blocks_input", "blocks_nested_transition"],
      "properties": {
        "enabled": { "type": "boolean" },
        "blocks_input": { "type": "boolean" },
        "blocks_nested_transition": { "type": "boolean" }
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["request", "lock_input", "fade_out", "stop_update", "drain_dma", "teardown_old", "reset_callbacks", "load_new", "fade_in", "unlock_input", "complete"]
      }
    },
    "resource_handoff": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "old_owner", "action", "new_owner"],
        "properties": {
          "resource": { "type": "string", "enum": ["VRAM", "CRAM", "VSRAM", "SAT", "HSCROLL", "WINDOW", "SPRITES", "AUDIO", "INPUT", "CAMERA", "DMA_QUEUE", "OTHER"] },
          "old_owner": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "enum": ["clear", "preserve", "flush", "handoff", "reload", "disable"] },
          "new_owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "callback_reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vint_reset", "hint_reset", "timer_reset"],
      "properties": {
        "vint_reset": { "type": "boolean" },
        "hint_reset": { "type": "boolean" },
        "timer_reset": { "type": "boolean" }
      }
    },
    "input_lock_policy": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "type": "string", "enum": ["ok", "needs_review", "blocked"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
