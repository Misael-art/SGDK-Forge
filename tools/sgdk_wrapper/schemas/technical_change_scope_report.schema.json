{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sgdk-forge.local/schemas/technical_change_scope_report.schema.json",
  "title": "technical_change_scope_report",
  "type": "object",
  "required": [
    "schema_version",
    "report_kind",
    "change_id",
    "changes_player_facing_visuals",
    "changes_assets",
    "changes_composition",
    "changes_presentation",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "report_kind": {
      "type": "string",
      "enum": ["technical_change_scope_report"]
    },
    "template_seed": {
      "type": "boolean"
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "changes_player_facing_visuals": {
      "type": "boolean"
    },
    "changes_assets": {
      "type": "boolean"
    },
    "changes_composition": {
      "type": "boolean"
    },
    "changes_presentation": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
