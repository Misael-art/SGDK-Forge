{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sgdk_wrapper/schemas/visual_source_of_truth.schema.json",
  "title": "Visual Source Of Truth",
  "description": "Locks the approved authorial source for visual generation and forbids derivative sprite sheets, runtime strips, contact sheets and partial candidates from becoming generation sources.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "asset_id",
    "evaluated_at",
    "status",
    "approved_authorial_source",
    "allowed_generation_sources",
    "forbidden_generation_sources",
    "obsolete_assets",
    "lineage_scan_policy",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "evaluated_at": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "needs_review",
        "blocked"
      ]
    },
    "approved_authorial_source": {
      "type": "object",
      "required": [
        "path",
        "role",
        "approval_status"
      ],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "model_sheet",
            "authorial_concept",
            "locked_key_pose_model_sheet"
          ]
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "approved_authorial_model_sheet",
            "approved_for_key_poses",
            "approved_as_direction"
          ]
        }
      }
    },
    "allowed_generation_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "source_status"
        ],
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "model_sheet",
              "visual_dna",
              "direction_brief",
              "art_gameplay_direction_gate",
              "lineart_blocking",
              "human_review_record"
            ]
          },
          "source_status": {
            "type": "string",
            "enum": [
              "approved_authorial_model_sheet",
              "approved_for_key_poses",
              "identity_contract",
              "direction_contract",
              "direction_brief",
              "lineart_gate",
              "human_approval"
            ]
          }
        }
      }
    },
    "forbidden_generation_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "obsolete_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "generation_source_status",
          "allowed_usage",
          "reason"
        ],
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "generation_source_status": {
            "const": "obsolete_for_generation_source"
          },
          "allowed_usage": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "negative_evidence",
                "comparison_only",
                "runtime_evidence_only",
                "do_not_use_for_generation"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "partial_runtime_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "generation_source_status",
          "runtime_status",
          "missing_gates"
        ],
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "generation_source_status": {
            "const": "obsolete_for_generation_source"
          },
          "runtime_status": {
            "type": "string",
            "enum": [
              "runtime_candidate_not_aaa_not_source",
              "runtime_evidence_only_not_source"
            ]
          },
          "missing_gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "lineage_scan_policy": {
      "type": "object",
      "required": [
        "blocked_fields",
        "scan_roots"
      ],
      "additionalProperties": true,
      "properties": {
        "blocked_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "source",
              "baseline",
              "reference_for_generation",
              "img2img_base",
              "generation_source",
              "image_reference"
            ]
          }
        },
        "scan_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "generation_source_locked",
        "next_sprite_sheet_must_start_from_model_sheet",
        "ready_for_aaa"
      ],
      "additionalProperties": true,
      "properties": {
        "generation_source_locked": {
          "type": "boolean"
        },
        "next_sprite_sheet_must_start_from_model_sheet": {
          "type": "boolean"
        },
        "ready_for_aaa": {
          "type": "boolean"
        }
      }
    }
  }
}
